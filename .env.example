# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=            # from @BotFather
ADMIN_USER_ID=                 # your numeric Telegram user id (enables /admin_stats)

# Free-tier LLM keys. The router fails over across these, so you can start with just one.
GROQ_API_KEY=                  # console.groq.com
GEMINI_API_KEY=                # aistudio.google.com
CEREBRAS_API_KEY=              # cloud.cerebras.ai
OPEN_ROUTER_API_KEY=           # openrouter.ai
